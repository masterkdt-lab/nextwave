{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "routes": [
    {
      "src": "/(.*)",
      "dest": "https://spark-feature-build.lovable.app/$1",
      "headers": {
        "Cache-Control": "no-store",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store",
        "x-vercel-enable-rewrite-caching": "0"
      }
    }
  ]
}
